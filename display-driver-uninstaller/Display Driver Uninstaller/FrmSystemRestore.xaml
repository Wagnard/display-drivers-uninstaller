<Window x:Name="frmSystemRestore" x:Class="Display_Driver_Uninstaller.FrmSystemRestore"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="frmSystemRestore"
	WindowStartupLocation="CenterScreen"
	ShowInTaskbar="False"
	SizeToContent="WidthAndHeight"
	ResizeMode="NoResize"
	Background="#FF12161D"
	Foreground="#FFF4F7FA">

	<Grid Background="#FF12161D">
		<Border Background="#FF181E27" BorderBrush="#FF546173" BorderThickness="1" Padding="18,14">
			<Label x:Name="lblSystemRestore"
				   Content="lblSystemRestore"
				   HorizontalContentAlignment="Center"
				   VerticalContentAlignment="Center"
				   FontFamily="Calibri"
				   FontSize="14"
				   Foreground="#FFF4F7FA" />
		</Border>
	</Grid>
</Window>

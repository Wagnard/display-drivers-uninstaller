<Window x:Class="Display_Driver_Uninstaller.FrmMain" x:Name="frmMain"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:Display_Driver_Uninstaller"
	xmlns:conv="clr-namespace:Display_Driver_Uninstaller.Converters"
	mc:Ignorable="d"

	Title="{Binding Settings.AppName, Mode=OneWay}"
	Height="625" Width="690"
	MinHeight="625" MinWidth="690" ResizeMode="CanResize" Icon="/Display%20Driver%20Uninstaller;component/Resources/DDU.ico"
	Visibility="Visible" WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" TrueValue="Visible" FalseValue="Collapsed" />
		<conv:BooleanToString x:Key="BoolToStr" TrueValue="x64" FalseValue="x86" />
		<conv:EnumToTextConverter x:Key="EnumToText" />

		<Style x:Key="MainButtonTextStyle" TargetType="{x:Type TextBlock}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,0" />
		</Style>

		<Style x:Key="MainMenuStyle" TargetType="{x:Type Menu}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainMenuBg}" />
			<Setter Property="BorderBrush" Value="{StaticResource brushMainMenuBg}" />
			<Setter Property="BorderThickness" Value="0,1,0,1" />
			<Setter Property="Padding" Value="0" />
		</Style>

		<Style x:Key="MainMenuItemStyle" TargetType="{x:Type MenuItem}">
			<Setter Property="Padding" Value="8,3" />
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainMenuBg}" />
			<Setter Property="BorderBrush" Value="{StaticResource brushMainControlBorder}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type MenuItem}">
						<Border x:Name="MenuItemBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="0">
							<Grid>
								<ContentPresenter x:Name="HeaderHost"
												  ContentSource="Header"
												  Margin="{TemplateBinding Padding}"
												  RecognizesAccessKey="True" />
								<Popup x:Name="PART_Popup"
									   Placement="Bottom"
									   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
									   AllowsTransparency="True"
									   Focusable="False"
									   PopupAnimation="Fade">
									<Border Background="{StaticResource brushMainControlBg}"
											BorderBrush="{StaticResource brushMainControlBorder}"
											BorderThickness="1"
											Padding="1">
										<StackPanel IsItemsHost="True"
													KeyboardNavigation.DirectionalNavigation="Cycle" />
									</Border>
								</Popup>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="Role" Value="TopLevelHeader">
								<Setter TargetName="MenuItemBorder" Property="BorderThickness" Value="0" />
							</Trigger>
							<Trigger Property="Role" Value="TopLevelItem">
								<Setter TargetName="MenuItemBorder" Property="BorderThickness" Value="0" />
							</Trigger>
							<Trigger Property="Role" Value="SubmenuHeader">
								<Setter TargetName="MenuItemBorder" Property="BorderThickness" Value="0" />
								<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
							</Trigger>
							<Trigger Property="Role" Value="SubmenuItem">
								<Setter TargetName="MenuItemBorder" Property="BorderThickness" Value="0" />
								<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
							</Trigger>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource brushMainControlBgHover}" />
							</Trigger>
							<Trigger Property="IsSubmenuOpen" Value="True">
								<Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource brushMainControlBgHover}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.55" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainActionButtonStyle" TargetType="{x:Type Button}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
			<Setter Property="BorderBrush" Value="{StaticResource brushMainControlBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="ButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Margin="{TemplateBinding Padding}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource brushMainControlBgHover}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource brushMainControlBgPressed}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainComboBoxStyle" TargetType="{x:Type ComboBox}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
			<Setter Property="BorderBrush" Value="{StaticResource brushMainControlBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,2,28,2" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBox}">
						<Grid>
							<ToggleButton x:Name="ToggleButton"
										  Focusable="False"
										  ClickMode="Press"
										  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="{x:Type ToggleButton}">
										<Border x:Name="ComboBorder"
												Background="{StaticResource brushMainControlBg}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}"
												SnapsToDevicePixels="True">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="28" />
												</Grid.ColumnDefinitions>
												<ContentPresenter Margin="8,2,4,2"
																  VerticalAlignment="Center"
																  HorizontalAlignment="Left"
																  Content="{TemplateBinding Content}" />
												<TextBlock Grid.Column="1"
														   Text="▼"
														   Foreground="{StaticResource brushMainText}"
														   VerticalAlignment="Center"
														   HorizontalAlignment="Center"
														   FontSize="10" />
											</Grid>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource brushMainControlBgHover}" />
											</Trigger>
											<Trigger Property="IsChecked" Value="True">
												<Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource brushMainControlBgHover}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<ContentPresenter IsHitTestVisible="False"
											  Margin="8,2,28,2"
											  VerticalAlignment="Center"
											  HorizontalAlignment="Left"
											  Content="{TemplateBinding SelectionBoxItem}"
											  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
											  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

							<Popup x:Name="Popup"
								   Placement="Bottom"
								   IsOpen="{TemplateBinding IsDropDownOpen}"
								   AllowsTransparency="True"
								   Focusable="False"
								   PopupAnimation="Slide">
								<Border Background="{StaticResource brushMainControlBg}"
										BorderBrush="{StaticResource brushMainControlBorder}"
										BorderThickness="1"
										SnapsToDevicePixels="True">
									<ScrollViewer SnapsToDevicePixels="True">
										<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="HasItems" Value="False">
								<Setter TargetName="Popup" Property="MinHeight" Value="22" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.55" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Style.Triggers>
				<Trigger Property="IsHighlighted" Value="True">
					<Setter Property="Background" Value="{StaticResource brushMainControlBgHover}" />
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{StaticResource brushMainSelection}" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="MainListBoxStyle" TargetType="{x:Type ListBox}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="{StaticResource brushMainLogBg}" />
			<Setter Property="BorderBrush" Value="{StaticResource brushMainControlBorder}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ListBox}">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								SnapsToDevicePixels="True">
							<ScrollViewer Padding="{TemplateBinding Padding}"
										  Focusable="False"
										  Background="{TemplateBinding Background}">
								<ItemsPresenter />
							</ScrollViewer>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
			<Setter Property="Foreground" Value="{StaticResource brushMainText}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{StaticResource brushMainSelection}" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<ImageBrush x:Key="logoAMD" ImageSource="/Display%20Driver%20Uninstaller;component/Resources/amd_logo.png" Stretch="Uniform" AlignmentY="Center" />
		<ImageBrush x:Key="logoNvidia" ImageSource="/Display%20Driver%20Uninstaller;component/Resources/nvidia_logo.png" Stretch="Uniform" AlignmentY="Center" />
		<ImageBrush x:Key="logoIntel" ImageSource="/Display%20Driver%20Uninstaller;component/Resources/intel_logo.jpg" Stretch="Uniform" AlignmentY="Center" />
		<ImageBrush x:Key="logoRealtek" ImageSource="/Display%20Driver%20Uninstaller;component/Resources/realtek-logo.png" Stretch="Uniform" AlignmentY="Center" />
		<ImageBrush x:Key="logoSoundBlaster" ImageSource="/Display%20Driver%20Uninstaller;component/Resources/creative_logo.png" Stretch="Uniform" AlignmentY="Center" />

	</Window.Resources>

	<Window.Style>
		<Style TargetType="{x:Type Window}">
			<Setter Property="Background" Value="{StaticResource brushMainControlBg}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.AMD}">
					<Setter Property="Background" Value="{StaticResource brushAmd}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.Nvidia}">
					<Setter Property="Background" Value="{StaticResource brushNvidia}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.Intel}">
					<Setter Property="Background" Value="{StaticResource brushIntel}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=Settings.SelectedAUDIO, Mode=OneWay}" Value="{x:Static local:AudioVendor.Realtek}">
					<Setter Property="Background" Value="{StaticResource brushRealtek}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=Settings.SelectedAUDIO, Mode=OneWay}" Value="{x:Static local:AudioVendor.SoundBlaster}">
					<Setter Property="Background" Value="{StaticResource brushSoundBlaster}"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Window.Style>

	<Grid FlowDirection="{Binding Path=Settings.FlowControl}" Background="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Background}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="350" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="20" />
			<!-- Space ( 30px ) -->
			<ColumnDefinition Width="250" MaxWidth="300" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<!-- Space ( 30px ) -->
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Menu Name="MenuStrip1" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.ColumnSpan="4" Style="{StaticResource MainMenuStyle}" ItemContainerStyle="{StaticResource MainMenuItemStyle}">
			<MenuItem x:Name="OptionsMenuItem" Header="OptionsMenuItem"/>

            <MenuItem x:Name="LinksMenuItem" Header="Links">
                <MenuItem x:Name="VisitDDUHomeMenuItem" Header="DDU Website" />
                <MenuItem x:Name="VisitDDUShopMenuItem" Header="DDU Merch Shop" />

                <Separator />

                <MenuItem x:Name="DownloadNvidiaMenuItem" Header="NVIDIA Driver Downloads" />
                <MenuItem x:Name="DownloadAmdMenuItem" Header="AMD Driver Downloads" />
                <MenuItem x:Name="DownloadIntelMenuItem" Header="Intel Driver Downloads" />

                <Separator />

                <MenuItem x:Name="VisitDiscord" Header="Discord Server" />
                <MenuItem x:Name="VisitSVNMenuItem" Header="GitHub Repository" />
            </MenuItem>

            <MenuItem x:Name="ExtendedLogMenuItem" Header="ExtendedLogMenuItem"/>

			<MenuItem x:Name="InfoMenuItem" Header="InfoMenuItem">
				<MenuItem x:Name="ToSMenuItem" Header="ToSMenuItem" />
				<MenuItem x:Name="AboutMenuItem" Header="AboutMenuItem" />
				<MenuItem x:Name="TranslatorsMenuItem" Header="TranslatorsMenuItem" />
				<MenuItem x:Name="PatronMenuItem" Header="PatronMenuItem" />
			</MenuItem>

			<MenuItem x:Name="TestMenuItem" Header="TESTING" Visibility="{Binding IsDebug, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<MenuItem x:Name="checkXMLMenuItem" Header="Check language files for errors" />
				<MenuItem x:Name="SetupAPIMenuItem" Header="Debug Tools" />
				<MenuItem x:Name="testingMenuItem" Header="Generic test" />
			</MenuItem>
		</Menu>

		<StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="10,5,10,5">
			<TextBlock x:Name="lblWinVersion" Text="lblWinVersionText" VerticalAlignment="Center" Foreground="{StaticResource brushMainText}" />
			<TextBlock FontWeight="Bold" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource brushMainText}">
				<TextBlock.Text>
					<MultiBinding StringFormat="{}{0} ({1})">
						<Binding Path="Settings.WinVersionText" />
						<Binding Path="Settings.WinIs64" Converter="{StaticResource BoolToStr}" />
					</MultiBinding>
				</TextBlock.Text>
			</TextBlock>
		</StackPanel>

		<DockPanel Grid.Row="2" Grid.RowSpan="1" Grid.Column="3" Margin="10,0">
			<DockPanel DockPanel.Dock="Bottom" Grid.Row="1" Grid.Column="3" >

			</DockPanel>

            <Border DockPanel.Dock="Bottom" Margin="0,0,0,25">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">

                        <Setter Property="Background" Value="Transparent"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.AMD}">
                                <Setter Property="Background" Value="{StaticResource logoAMD}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.Nvidia}">
                                <Setter Property="Background" Value="{StaticResource logoNvidia}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Settings.SelectedGPU, Mode=OneWay}" Value="{x:Static local:GPUVendor.Intel}">
                                <Setter Property="Background" Value="{StaticResource logoIntel}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Settings.SelectedAUDIO, Mode=OneWay}" Value="{x:Static local:AudioVendor.Realtek}">
                                <Setter Property="Background" Value="{StaticResource logoRealtek}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Settings.SelectedAUDIO, Mode=OneWay}" Value="{x:Static local:AudioVendor.SoundBlaster}">
                                <Setter Property="Background" Value="{StaticResource logoSoundBlaster}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DockPanel>

		<DockPanel Grid.Row="2" x:Name="ButtonsPanel" >
			<DockPanel.Resources>
				<Style TargetType="Button" BasedOn="{StaticResource MainActionButtonStyle}">
					<Setter Property="MinWidth" Value="250" />
					<Setter Property="MaxWidth" Value="320" />
					<Setter Property="MinHeight" Value="37" />
					<Setter Property="MaxHeight" Value="100" />
					<Setter Property="Margin" Value="10,10,10,0" />
				</Style>
			</DockPanel.Resources>

			<Button DockPanel.Dock="Top" x:Name="btnCleanRestart" HorizontalAlignment="Stretch" >
				<TextBlock Text="btnRestart" Style="{StaticResource MainButtonTextStyle}" />
			</Button>
			<Button DockPanel.Dock="Top" x:Name="btnClean" HorizontalAlignment="Stretch" >
				<TextBlock Text="btnClean" Style="{StaticResource MainButtonTextStyle}" />
			</Button>
			<Button DockPanel.Dock="Top" x:Name="btnCleanShutdown" HorizontalAlignment="Stretch" >
				<TextBlock Text="btnCleanShutdown" Style="{StaticResource MainButtonTextStyle}" />
			</Button>
			<Button DockPanel.Dock="Top" x:Name="btnCleanCaches" HorizontalAlignment="Stretch" >
				<TextBlock Text="btnCleanCaches" Style="{StaticResource MainButtonTextStyle}" />
			</Button>
		</DockPanel>

		<DockPanel Grid.Row="4" Grid.Column="3" x:Name="RightButtonsPanel" >
			<DockPanel.Resources>
				<Style TargetType="Button" BasedOn="{StaticResource MainActionButtonStyle}">
					<Setter Property="MinWidth" Value="230" />
					<Setter Property="MaxWidth" Value="230" />
					<Setter Property="MinHeight" Value="37" />
					<Setter Property="MaxHeight" Value="100" />
					<Setter Property="Margin" Value="10,10,10,0" />
				</Style>
			</DockPanel.Resources>
			<Button DockPanel.Dock="Top" x:Name="btnWuRestore" MinHeight="40" MaxHeight="60" Visibility="{Binding Settings.PreventWinUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<TextBlock Text="btnWuRestore" Style="{StaticResource MainButtonTextStyle}" />
			</Button>
		</DockPanel>
		
		<DockPanel LastChildFill="True" Margin="10" Grid.Row="5" Grid.Column="3">
			<StackPanel DockPanel.Dock="Bottom">
				<Label x:Name="lblLanguage" Content="lblLanguage" FontWeight="Bold" Foreground="{StaticResource brushMainText}" />
				<ComboBox x:Name="cbLanguage" ItemsSource="{Binding Settings.LanguageOptions, Mode=OneWay}" SelectedItem="{Binding Settings.SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="DisplayText" VerticalAlignment="Top" Height="22" IsReadOnly="True" Style="{StaticResource MainComboBoxStyle}" ItemContainerStyle="{StaticResource MainComboBoxItemStyle}" />
			</StackPanel>

			<StackPanel Visibility="{Binding Settings.ShowOffer, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" DockPanel.Dock="Top" VerticalAlignment="Center">
				<Label x:Name="lblOffer" FontWeight="Bold" Content="lblOffer" HorizontalContentAlignment="Center" FontSize="11" Foreground="{StaticResource brushMainText}" />

				<Button x:Name="imgOffer">
					<Button.Template>
						<ControlTemplate>
							<Image Source="Resources/btn_partner.png" ToolTip="{Binding ElementName=lblOffer, Path=ToolTip, Mode=OneWay}"/>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>
		</DockPanel>

		<Label Content="lblLog" Grid.Row="3" Name="lblLog" VerticalContentAlignment="Center" FontWeight="Bold" Margin="0,2.04,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource brushMainText}" />

		<ListBox Name="lbLog" Focusable="False" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,3,0,0" Grid.RowSpan="2" Style="{StaticResource MainListBoxStyle}">
			<ListBox.ItemContainerStyle>
				<Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MainListBoxItemStyle}">
					<Setter Property="Focusable" Value="False" />
				</Style>
			</ListBox.ItemContainerStyle>
		</ListBox>

		<Label Name="lblUpdate" Content="{Binding Settings.UpdateAvailable, Mode=OneWay, Converter={StaticResource EnumToText}}" Grid.Row="6" Grid.ColumnSpan="4" Margin="0,0,10,0" Foreground="{StaticResource brushMainText}" />

		<Border Grid.Row="7" Grid.ColumnSpan="4" Margin="0,10,0,0" Background="{StaticResource brushMainStatusBg}" BorderBrush="{StaticResource brushMainControlBorder}" BorderThickness="1,1,1,0">
			<Grid HorizontalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="96" />
					<ColumnDefinition Width="99.362"/>
					<ColumnDefinition Width="33.362"/>
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="lblDonate" Grid.Column="0" Text="lblDonate" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="6,5.585,6,5.584" Foreground="{StaticResource brushMainText}" />

				<Button x:Name="imgDonate" Grid.Column="1" HorizontalAlignment="Left" Width="96" >
					<Button.Template>
						<ControlTemplate>
							<Image Source="Resources/btn_donate_LG.gif"/>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<Button x:Name="imgPatron" Grid.Column="2" Width="96" Margin="0,0,3.362,0" HorizontalAlignment="right" >
					<Button.Template>
						<ControlTemplate>
							<Image Source="Resources/become_a_patron_button.png"/>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<Button x:Name="imgDiscord" Grid.Column="3" Width="32" Margin="0,0,3.362,0" HorizontalAlignment="right" MaxHeight="32" >
					<Button.Template>
						<ControlTemplate>
							<Image Source="Resources/discord@2x.png"/>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</Grid>
		</Border>
		<DockPanel Grid.Column="3" Grid.Row="3" >
			<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
				<ComboBox Name="cbSelectedType" HorizontalAlignment="Stretch" VerticalAlignment="Center" DockPanel.Dock="Top" Margin="10,0,10,0" SelectedIndex="0" Style="{StaticResource MainComboBoxStyle}" ItemContainerStyle="{StaticResource MainComboBoxItemStyle}" />
				<ComboBox x:Name="cbSelectedGPU" HorizontalAlignment="Stretch" VerticalAlignment="Center" DockPanel.Dock="Top" SelectedIndex="0" Margin="10,0,10,0" Style="{StaticResource MainComboBoxStyle}" ItemContainerStyle="{StaticResource MainComboBoxItemStyle}" />
			</StackPanel>
		</DockPanel>
	</Grid>
</Window>
